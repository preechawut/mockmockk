# Local development only. Load this file into your shell for make run.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://app:localpassword@localhost:5433/app?sslmode=disable
SHUTDOWN_TIMEOUT=10s
# Compose host ports; DATABASE_URL above must match DB_PORT for host-side Go.
DB_PORT=5433
API_PORT=8080

LOG_LEVEL=info
LOG_FORMAT=json

SERVICE_NAME=mockmock-service
REQUEST_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=15s
# HTTP_READ_TIMEOUT=15s
# DB_MAX_CONNS=25
# DB_MIN_CONNS=5
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
CORS_ALLOWED_ORIGINS=*

